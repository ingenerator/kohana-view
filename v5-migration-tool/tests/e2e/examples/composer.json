{
  "require": {
    "ingenerator/kohana-view": "*@dev"
  },
  "repositories": {
    "ingen-packages": {
      "type": "composer",
      "url": "https://php-packages.ingenerator.com"
    }
  },
  "extra": {
    "installer-paths": {
      "vendor/{$vendor}/{$name}": [
        "type:kohana-module"
      ]
    }
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true
    }
  }
}
